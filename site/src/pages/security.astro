---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { repoMarkdown } from '../lib/readme';

// The repository's SECURITY.md, so the policy has one source.
const policy = repoMarkdown( 'SECURITY.md', SITE.repoUrl );
---
<Base title="Security" description="How to report a security problem in Airworthy, and what happens next.">
	<div class="wrap page-head">
		<p class="eyebrow">Security</p>
		<h1>Security policy</h1>
		<p class="lede">Found a security problem? Email <a href={ `mailto:${ SITE.email.security }` }>{ SITE.email.security }</a>. Please don't post it in a public forum.</p>
	</div>
	<div class="wrap prose" style="padding-bottom: 80px;">
		<Fragment set:html={ policy } />
		<p class="muted">Machine-readable contact details: <a href="/.well-known/security.txt">/.well-known/security.txt</a></p>
	</div>
</Base>
