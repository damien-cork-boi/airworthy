---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
	<div class="wrap page-head" style="padding-bottom: 96px;">
		<p class="eyebrow">404</p>
		<h1>This page didn't make it off the runway.</h1>
		<p class="lede">The page you're looking for doesn't exist or has moved.</p>
		<p><a class="button button-primary" href="/">Back to the home page</a> <a class="button button-secondary" href="/docs/">Read the docs</a></p>
	</div>
</Base>
