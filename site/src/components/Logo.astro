---
/**
 * Airworthy mark (placeholder until the brand step): a plane climbing past a check mark.
 */
interface Props {
	title?: string;
}
const { title } = Astro.props;
---
<svg viewBox="0 0 64 64" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} xmlns="http://www.w3.org/2000/svg">
	{title && <title>{title}</title>}
	<rect width="64" height="64" rx="14" fill="#1f5fd0" />
	<path d="M14 36l8 8 12-14" fill="none" stroke="#9fe0b0" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
	<path d="M30 40L52 14 24 26l8 3z" fill="#ffffff" />
	<path d="M32 29l3 11 17-26z" fill="#d6e4fb" />
</svg>
