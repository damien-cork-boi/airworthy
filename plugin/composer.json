{
    "name": "digitalkind/airworthy",
    "description": "Scan engine dependencies for Airworthy. Installed and scoped by bin/build.sh; not loaded from here at runtime.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "require": {
        "php": ">=7.2",
        "squizlabs/php_codesniffer": "4.0.4",
        "phpcsstandards/phpcsutils": "1.2.3",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
        "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2"
    },
    "config": {
        "platform": { "php": "7.2.5" },
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": false },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
